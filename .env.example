# Unified OpenAI-compatible LLM provider configuration (never commit real keys).
A02_LLM_API_KEY=
A02_LLM_BASE_URL=https://api.openai.com/v1
A02_LLM_MODEL=gpt-4o-mini
A02_LLM_TIMEOUT_SECONDS=30
A02_LLM_TEMPERATURE=0.2
A02_LLM_MAX_RETRIES=2
A02_LLM_MOCK_MODE=false
# Optional deterministic text used only when mock mode is enabled.
A02_LLM_MOCK_RESPONSE=Mock response

# Existing A02 demo switch; Agents skip external LLM calls when enabled.
A02_DEMO_MODE=true

# Stage-3 state persistence. Use one option only. With neither set, the backend
# uses backend/.runtime/career_state.sqlite3 for a durable local Demo database.
A02_STATE_DB_PATH=
A02_DATABASE_URL=

# Lightweight four-table REST PostgreSQL connection. Production credentials
# must be injected from a protected environment file and never committed.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=careerpulse_micro
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_CONNECT_TIMEOUT=5

# Ant TBox minimal stage-3 HTTP tools. Generate a strong deployment secret;
# never commit a real token. CareerPulse cancels a tool call at this timeout.
A02_TBOX_API_TOKEN=
A02_TBOX_TOOL_TIMEOUT_SECONDS=25

# CareerPulse -> Ant TBox formal agent chat. This outbound credential is
# intentionally separate from A02_TBOX_API_TOKEN (the inbound tool secret).
# TBOX_CHAT_AUTHORIZATION is sent as the complete Authorization header value
# issued by TBox, for example a value beginning with "Tbox-".
TBOX_CHAT_API_URL=https://api.tbox.cn/api/chat
TBOX_CHAT_AUTHORIZATION=
TBOX_APP_ID=
# Generate a separate high-entropy secret for stable HMAC pseudonymous userId.
TBOX_USER_ID_SECRET=
TBOX_CHAT_TIMEOUT_SECONDS=45

# Optional standard remote MCP Server. Keep disabled until the endpoint is
# deployed with HTTPS and the platform-specific connection has been tested.
MCP_ENABLED=false
MCP_EXPOSE_DATABASE_TOOLS=false
MCP_AUTH_ENABLED=true
MCP_API_TOKEN=
MCP_HOST=127.0.0.1
MCP_PORT=8000
MCP_PATH=/mcp
MCP_TOOL_TIMEOUT_SECONDS=25
# Comma-separated SDK DNS-rebinding allowlists. Set the real public host/origin
# before remote deployment; never use a wildcard copied from an example.
MCP_ALLOWED_HOSTS=127.0.0.1:*,localhost:*
MCP_ALLOWED_ORIGINS=http://127.0.0.1:*,http://localhost:*
