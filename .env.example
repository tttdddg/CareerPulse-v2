# Unified OpenAI-compatible LLM provider configuration (never commit real keys).
A02_LLM_API_KEY=
A02_LLM_BASE_URL=https://api.openai.com/v1
A02_LLM_MODEL=gpt-4o-mini
A02_LLM_TIMEOUT_SECONDS=30
A02_LLM_TEMPERATURE=0.2
A02_LLM_MAX_RETRIES=2
A02_LLM_MOCK_MODE=false
# Optional deterministic text used only when mock mode is enabled.
A02_LLM_MOCK_RESPONSE=Mock response

# Existing A02 demo switch; Agents skip external LLM calls when enabled.
A02_DEMO_MODE=true
