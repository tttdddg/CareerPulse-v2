# systemd EnvironmentFile for CareerPulse on Ubuntu 22.04.
# Copy to /etc/careerpulse/careerpulse.env, set mode 0640, and replace every
# deployment-specific value. Never commit the populated production file.

# First deployment defaults to deterministic Demo behavior. Set both flags to
# false only after the real LLM credentials and required Prompt assets exist.
A02_DEMO_MODE=true
A02_LLM_MOCK_MODE=true
A02_LLM_API_KEY=
A02_LLM_BASE_URL=https://api.openai.com/v1
A02_LLM_MODEL=gpt-4o-mini
A02_LLM_TIMEOUT_SECONDS=30
A02_LLM_TEMPERATURE=0.2
A02_LLM_MAX_RETRIES=2
A02_LLM_MOCK_RESPONSE="Mock response"

# Durable MCP/Agent state. Use exactly one of these options. SQLite is the
# minimal first-deployment default and must live outside the release directory.
A02_STATE_DB_PATH=/var/lib/careerpulse/career_state.sqlite3
A02_DATABASE_URL=

# Legacy REST PostgreSQL connection. These routes remain unavailable until the
# existing database and its owner-approved base schema are supplied.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DATABASE=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_CONNECT_TIMEOUT=5

# Authenticated stage-3 REST tools. Generate a different token from MCP_API_TOKEN.
A02_TBOX_API_TOKEN=
A02_TBOX_TOOL_TIMEOUT_SECONDS=25

# Optional outbound TBox chat integration. Keep blank until real tenant
# credentials are available; /api/tbox/chat then fails closed with HTTP 503.
TBOX_CHAT_API_URL=https://api.tbox.cn/api/chat
TBOX_CHAT_AUTHORIZATION=
TBOX_APP_ID=
TBOX_USER_ID_SECRET=
TBOX_CHAT_TIMEOUT_SECONDS=45

# Public MCP Streamable HTTP endpoint. MCP_API_TOKEN is mandatory when enabled.
MCP_ENABLED=true
MCP_AUTH_ENABLED=true
MCP_API_TOKEN=
MCP_HOST=127.0.0.1
MCP_PORT=8000
MCP_PATH=/mcp
MCP_TOOL_TIMEOUT_SECONDS=25

# Replace api.example.com with the fixed public DNS name. Loopback entries allow
# the local smoke test while DNS-rebinding protection remains enabled.
MCP_ALLOWED_HOSTS=api.example.com,127.0.0.1:8000,localhost:8000
MCP_ALLOWED_ORIGINS=https://api.example.com
