[Unit]
Description=CareerPulse FastAPI and MCP service
Documentation=file:/opt/careerpulse/app/deploy/README.md
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=careerpulse
Group=careerpulse
WorkingDirectory=/opt/careerpulse/app/backend
EnvironmentFile=/etc/careerpulse/careerpulse.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/careerpulse/venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 1 --proxy-headers --forwarded-allow-ips=127.0.0.1 --no-server-header
Restart=on-failure
RestartSec=5s
TimeoutStartSec=30s
TimeoutStopSec=30s
KillSignal=SIGINT
UMask=0027

NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
StateDirectory=careerpulse
StateDirectoryMode=0750
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
